<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#151A22"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SETTINGS"
        android:textColor="#00E5FF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:gravity="center" />
    
    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_back_arrow"
        android:padding="8dp"
        android:contentDescription="Back"
        android:layout_marginBottom="16dp"
        android:layout_gravity="start"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
        
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Script Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SCRIPT"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="8dp"/>
            
            <TextView
                android:id="@+id/tv_current_script"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Current: None"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_available_scripts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Available Scripts:\nNone"
                android:textColor="#AAAAAA"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btn_new_script"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEW SCRIPT"
                android:backgroundTint="#1F2937"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp"/>

            <!-- Permissions Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PERMISSION"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/btn_shizuku_perm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="REQUEST SHIZUKU PERMISSION"
                android:backgroundTint="#1F2937"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btn_saf_perm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GRANT ANDROID/DATA ACCESS"
                android:backgroundTint="#1F2937"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp"/>

            <!-- Game Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GAME"
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Hologram -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#1F2937"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HOLOGRAM"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <Switch
                    android:id="@+id/switch_hologram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#00E5FF"
                    android:trackTint="#7700E5FF"/>
            </LinearLayout>

            <!-- Anti-Ban -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#1F2937"
                android:layout_marginBottom="24dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ANTI - BAN"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <Switch
                    android:id="@+id/switch_anti_ban"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumbTint="#00E5FF"
                    android:trackTint="#7700E5FF"/>
            </LinearLayout>

            <!-- Headshot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#1A1F29"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:alpha="0.5">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HEADSHOT (Locked)"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:clickable="false" />
            </LinearLayout>

            <!-- Streamer Proof -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#1A1F29"
                android:gravity="center_vertical"
                android:alpha="0.5">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="STREAMER PROOF (Locked)"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:clickable="false" />
            </LinearLayout>
            <!-- Delete Reports Button -->
            <Button
                android:id="@+id/btn_delete_reports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DELETE REPORTS"
                android:backgroundTint="#FF5252"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"/>
            
        </LinearLayout>
    </ScrollView>
</LinearLayout>
