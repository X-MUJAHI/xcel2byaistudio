<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#151A22">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Video Compressor"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_videos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/ll_compression_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#1F2937"
        android:padding="16dp"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tv_selected_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Video: None"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Video Quality (Bitrate):"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/spinner_quality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#FFFFFF" />

        <Button
            android:id="@+id/btn_compress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Start Compression"
            android:backgroundTint="#00E5FF"
            android:textColor="#151A22" />
            
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            style="?android:attr/progressBarStyleHorizontal" />
            
        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:text="Progress: 0%"
            android:textAlignment="center"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
