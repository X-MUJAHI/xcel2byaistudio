<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/glass_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Anti-Ban Verification"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select an active UID to apply anti-ban protections before launching."
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <ListView
            android:id="@+id/list_uids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="#444444"
            android:dividerHeight="1dp"/>

        <ProgressBar
            android:id="@+id/progress_loading_uids"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#00E5FF"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tv_no_uids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No UIDs found. Please play the game once normally to generate a UID folder."
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp"/>
            
        <Button
            android:id="@+id/btn_cancel_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANCEL"
            android:backgroundTint="#2D3748"
            android:textColor="#FFFFFF"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</FrameLayout>
